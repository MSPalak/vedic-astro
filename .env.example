# Copy to .env.local for local dev, or set these in Render's dashboard.
# Auth is OPTIONAL: with these unset the app runs fully (login disabled).
# With them set, the login screen + sessions activate.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Provided automatically by Render's managed Postgres (render.yaml wires it).
DATABASE_URL=

NEXT_TELEMETRY_DISABLED=1
